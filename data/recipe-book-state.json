        },
        {
          "qty": 2.67,
          "unit": "tbsp",
          "name": "soy sauce",
          "notes": "",
          "category": "pantry",
          "preferredProduct": null
        },
        {
          "qty": 12,
          "unit": "clove",
          "name": "garlic",
          "notes": "minced",
          "category": "produce",
          "preferredProduct": null
        },
        {
          "qty": 8,
          "unit": "each",
          "name": "green onions",
          "notes": "chopped, plus more for topping",
          "category": "produce",
          "preferredProduct": null
        },
        {
          "qty": 0.5,
          "unit": "cup",
          "name": "peanuts",
          "notes": "crushed and toasted, for topping",
          "category": "pantry",
