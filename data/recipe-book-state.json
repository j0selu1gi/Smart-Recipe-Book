          "notes": "e.g. Mae Ploy or Aroy-D",
          "preferredProduct": null,
          "qty": 2,
          "unit": "tbsp"
        },
        {
          "category": "produce",
          "name": "lime zest",
          "notes": "",
          "preferredProduct": null,
