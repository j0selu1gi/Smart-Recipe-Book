          "name": "yellow onion",
          "notes": "small, thinly sliced",
          "preferredProduct": null,
          "qty": 1,
          "unit": "each"
        },
        {
          "category": "produce",
          "name": "garlic",
          "notes": "thinly sliced",
          "preferredProduct": null,
          "qty": 2,
          "unit": "clove"
        },
        {
          "category": "produce",
          "name": "lemongrass",
          "notes": "6-inch piece, smashed, cut into 1-inch slices (optional)",
          "preferredProduct": null,
          "qty": 1,
