        },
        {
          "category": "produce",
          "name": "fresh ginger",
          "notes": "1-inch piece, peeled, thinly sliced",
          "preferredProduct": null,
          "qty": 1,
          "unit": "each"
        },
        {
          "category": "produce",
          "name": "sweet potato",
          "notes": "cubed, about 2 lb",
          "preferredProduct": null,
          "qty": 4,
          "unit": "cup"
        },
        {
          "category": "produce",
          "name": "red bell peppers",
          "notes": "cut into ½-inch-thick strips",
          "preferredProduct": null,
          "qty": 2,
          "unit": "each"
        },
        {
          "category": "pantry",
          "name": "cooked rice",
          "notes": "for serving (optional)",
          "preferredProduct": null,
          "qty": 8,
          "unit": "each"
        }
      ],
      "steps": [
        "Preheat the oven to 350°F with a rack in the center position.",
        "Season the beef all over with the salt and pepper. Heat the olive oil in a Dutch oven over medium-high heat. Once the oil is glistening, add the meat and cook until browned all over, about 5 minutes per side. Transfer the beef to a plate.",
        "Set aside 1 cup of the coconut milk for later. To the Dutch oven, add the remaining coconut milk, 1 cup of the beef stock, the red curry paste, lime zest, lime juice, onion, garlic, lemongrass, and ginger. Whisk to combine. Bring to a simmer, then return the meat to the pot along with any collected juices, nestling it into the liquid. Cover and transfer to the oven. Cook for about 2–2½ hours, until the meat is very tender. Transfer the meat to a plate and shred with two forks, discarding any large pieces of fat.",
        "Return the shredded beef to the curry. Add the remaining 1 cup beef stock, the reserved 1 cup coconut milk, sweet potato, and bell pepper. Bring to a boil, then reduce the heat to medium-low and simmer until the sweet potato is tender, about 20 minutes.",
        "Serve the curry spooned over cooked rice if using. Top with cilantro, Thai basil, and Thai chilies if desired.",
        "No oven? This also works in a slow cooker (about 6 hours) or an Instant Pot (90 minutes) — see themodernproper.com/red-curry-beef for those variations."
      ]
    }
